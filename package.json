{
  "name": "diego-bakery-api",
  "version": "1.0.0",
  "description": "Diego Bakery - Offline-first business management API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:business": "tsx scripts/business-engine.test.ts"
  },
  "keywords": [
    "bakery",
    "business",
    "management",
    "offline-first"
  ],
  "author": "Diego Bakery",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.7.0",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "@types/multer": "^2.2.0"
  }
}
