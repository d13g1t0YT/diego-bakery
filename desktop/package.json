{
  "name": "diego-bakery-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Diego Bakery V1 para Windows",
  "main": "main.cjs",
  "scripts": {
    "prepare-renderer": "node scripts/copy-renderer.cjs",
    "start": "npm run prepare-renderer && electron .",
    "dist:win": "npm run prepare-renderer && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pe.diegobakery.desktop",
    "productName": "Diego Bakery",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "renderer/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
